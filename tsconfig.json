{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"sourceMap": true,
		"outDir": "./dist",
		"rootDirs": [
			"src",
			"common"
		],
		"strict": true,
		"moduleResolution": "Node16",
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true
	},
	"include": [
		"src",
		"common"
	],
	"exclude": [
		"node_modules",
		"dist",
		"webviews"
	]
}

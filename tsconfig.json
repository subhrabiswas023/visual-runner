{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "sourceMap": true,
        "outDir": "./dist",
        "rootDirs": ["src", "types"],
        "strict": true,
        "noImplicitOverride": true,
        "moduleResolution": "Node16",
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "types": ["node"],
        "paths": {
            "@lib/*": ["./lib/*"],
            "@types/*": ["./types/*"],
        }
    },
    "include": ["src", "types", "scripts", "lib"],
    "exclude": []
}

{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"moduleResolution": "Node16",
		"allowSyntheticDefaultImports": true
	},
	"exclude": [
		"node_modules",
		"dist"
	]
}

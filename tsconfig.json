{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"moduleResolution": "Node16",
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true
	},
	"exclude": [
		"node_modules",
		"dist",
		"webviews"
	]
}

{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": ".",
        "rootDirs": ["src", "common"],
        "strict": true,
        "moduleResolution": "Node16",
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "paths": {
            "@lib/*": ["lib/*"]
        }
    },
    "include": ["src", "common", "scripts", "lib"],
    "exclude": ["node_modules", "dist", "webviews"]
}

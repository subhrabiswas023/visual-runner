{
    "extends": "@tsconfig/svelte/tsconfig.json",
    "include": [
        "./**/*",
        "../rollup.config.js",
        "../global.d.ts",
        "../common/types.ts"
    ],
    "exclude": ["../node_modules/*"],
    "compilerOptions": { 
      "strict": true, 
      "types": ["node", "svelte"],
      "paths": {
        "@common/*": ["../common/*"],
        "@stores/*": ["./stores/*"]
      }
    }
}

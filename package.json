{
  "name": "visual-runner",
  "displayName": "Visual Runner",
  "description": "A clean, interactive console for running code - no terminal clutter, just pure interaction",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "publisher": "subhrabiswas",
  "main": "dist/src/extension.js",
  "contributes": {
    "commands": [],
    "viewsContainers": {
      "panel": [
        {
          "id": "visual-console",
          "title": "Visual Console",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "visual-console": [
        {
          "id": "visual-runner.console",
          "name": "Visual Console",
          "type": "webview",
          "visibility": "visible",
          "icon": "$(terminal)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run clean  && npm run build:contribution && npm run compile:webview && npm run compile:extension",
    "clean": "rmdir /s /q dist",
    "build:contribution": "ts-node -r tsconfig-paths/register scripts/build-contribution.ts",
    "compile:webview": "vite build --config vite.config.webview.mjs",
    "compile:extension": "node esbuild.mjs",
    "watch": "concurrently \"npm run watch:webview\" \"npm run watch:extension\"",
    "watch:webview": "vite build --config vite.config.webview.mjs --watch",
    "watch:extension": "tsc -p tsconfig.json -w",
    "package": "npm run compile",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.99.0",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/codicons": "^0.0.39",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.1",
    "esbuild-node-externals": "^1.20.1",
    "esbuild-plugin-tsconfig-paths": "^1.0.2",
    "eslint": "^9.23.0",
    "svelte": "^5.38.6",
    "svelte-check": "^4.3.1",
    "svelte-preprocess": "^6.0.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "license": "MIT"
}
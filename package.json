{
  "name": "visual-runner",
  "displayName": "Visual Runner",
  "description": "A clean, interactive console to run and test code with managed inputs - no terminal clutter, just pure interaction",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "visual-runner-inputs.refresh",
        "title": "Refresh Inputs",
        "category": "Visual Runner",
        "icon": "$(refresh)"
      },
      {
        "command": "visual-runner-inputs.deleteItem",
        "title": "Delete Item",
        "category": "Visual Runner",
        "icon": "$(trash)"
      },
      {
        "command": "visual-runner-inputs.addFile",
        "title": "Add File",
        "category": "Visual Runner",
        "icon": "$(add)"
      },
      {
        "command": "visual-runner-inputs.addInput",
        "title": "Add Input",
        "category": "Visual Runner",
        "icon": "$(add)"
      },
      {
        "command": "visual-runner-inputs.renameInput",
        "title": "Rename Input",
        "category": "Visual Runner",
        "icon": "$(edit)"
      },
      {
        "command": "visual-runner-inputs.addLine",
        "title": "Add Line",
        "category": "Visual Runner",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "visual-runner-inputs.addFile",
          "when": "view == visual-runner-inputs",
          "group": "navigation"
        },
        {
          "command": "visual-runner-inputs.refresh",
          "when": "view == visual-runner-inputs",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "visual-runner-inputs.addInput",
          "when": "view == visual-runner-inputs && viewItem == file",
          "group": "inline@1"
        },
        {
          "command": "visual-runner-inputs.addInput",
          "when": "view == visual-runner-inputs && viewItem == file",
          "group": "modification@1"
        },
        {
          "command": "visual-runner-inputs.renameInput",
          "when": "view == visual-runner-inputs && viewItem == input",
          "group": "inline@1"
        },
        {
          "command": "visual-runner-inputs.addLine",
          "when": "view == visual-runner-inputs && viewItem == input",
          "group": "inline@1"
        },
        {
          "command": "visual-runner-inputs.deleteItem",
          "when": "view == visual-runner-inputs && (viewItem == file || viewItem == input)",
          "group": "inline@2"
        },
        {
          "command": "visual-runner-inputs.renameInput",
          "when": "view == visual-runner-inputs && viewItem == input",
          "group": "modification@1"
        },
        {
          "command": "visual-runner-inputs.deleteItem",
          "when": "view == visual-runner-inputs && (viewItem == file || viewItem == input)",
          "group": "modification@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visual-runner",
          "title": "Visual Runner",
          "icon": "$(play)"
        }
      ],
      "panel": [
        {
          "id": "visual-console",
          "title": "Visual Console",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "visual-runner": [
        {
          "id": "visual-runner-inputs",
          "name": "Inputs",
          "type": "tree",
          "visibility": "collapsed",
          "icon": "$(list-tree)"
        }
      ],
      "visual-console": [
        {
          "id": "visual-console",
          "name": "Visual Console",
          "type": "webview",
          "visibility": "visible",
          "icon": "$(terminal)"
        }
      ]
    },
    "configuration": {
      "title": "Visual Runner",
      "properties": {
        "visualRunner.execution.maxBuffer": {
          "type": "number",
          "default": 1048576,
          "description": "Maximum output buffer size in bytes"
        },
        "visualRunner.execution.shell": {
          "type": "string",
          "description": "Custom shell for execution (leave empty for default)"
        },
        "visualRunner.cache.lifetime": {
          "type": "number",
          "default": 3600000,
          "description": "Cache cleanup interval in milliseconds"
        },
        "visualRunner.storage.location": {
          "type": "string",
          "default": ".vscode/.runner",
          "description": "Input storage location relative to workspace"
        },
        "visualRunner.storage.maxSize": {
          "type": "number",
          "default": 10485760,
          "description": "Maximum storage size in bytes"
        },
        "visualRunner.storage.autoSave": {
          "type": "number",
          "default": 1000,
          "description": "Auto-save frequency in milliseconds"
        },
        "visualRunner.input.defaultMode": {
          "type": "string",
          "enum": [
            "sequential",
            "parallel"
          ],
          "default": "sequential",
          "description": "Default execution mode for multiple inputs"
        },
        "visualRunner.input.autoFocus": {
          "type": "boolean",
          "default": true,
          "description": "Auto-focus input field when waiting for input"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:webviews && npm run compile:extension",
    "compile:webviews": "rollup -c",
    "compile:extension": "webpack",
    "watch": "concurrently \"npm run watch:webviews\" \"npm run watch:extension\"",
    "watch:webviews": "rollup -c -w",
    "watch:extension": "webpack --watch",
    "package": "npm run compile && webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@tsconfig/svelte": "^5.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/codicons": "^0.0.39",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.23.0",
    "rollup-plugin-css-only": "^4.5.4",
    "rollup-plugin-svelte": "^7.2.3",
    "rollup-plugin-terser": "^7.0.2",
    "style-loader": "^4.0.0",
    "svelte": "^5.38.6",
    "svelte-check": "^4.3.1",
    "svelte-loader": "^3.2.4",
    "svelte-preprocess": "^6.0.3",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "license": "MIT"
}

{
  "name": "visual-runner",
  "displayName": "Visual Runner",
  "description": "A clean, interactive console to run and test code with managed inputs - no terminal clutter, just pure interaction",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "visual-runner.inputs.refresh",
        "title": "Refresh Inputs",
        "category": "Visual Runner",
        "icon": "$(refresh)"
      },
      {
        "command": "visual-runner.inputs.deleteItem",
        "title": "Delete Item",
        "category": "Visual Runner",
        "icon": "$(trash)"
      },
      {
        "command": "visual-runner.inputs.addFile",
        "title": "Add File",
        "category": "Visual Runner",
        "icon": "$(add)"
      },
      {
        "command": "visual-runner.inputs.addInput",
        "title": "Add Input",
        "category": "Visual Runner",
        "icon": "$(add)"
      },
      {
        "command": "visual-runner.inputs.renameInput",
        "title": "Rename Input",
        "category": "Visual Runner",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "visual-runner.inputs.addFile",
          "when": "view == visual-runner.inputs",
          "group": "navigation"
        },
        {
          "command": "visual-runner.inputs.refresh",
          "when": "view == visual-runner.inputs",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "visual-runner.inputs.addInput",
          "when": "view == inputs && viewItem == file",
          "group": "inline@1"
        },
        {
          "command": "visual-runner.inputs.addInput",
          "when": "view == inputs && viewItem == file",
          "group": "modification@1"
        },
        {
          "command": "visual-runner.inputs.renameInput",
          "when": "view == inputs && viewItem == input",
          "group": "inline@1"
        },
        {
          "command": "visual-runner.inputs.deleteItem",
          "when": "view == inputs && (viewItem == file || viewItem == input)",
          "group": "inline@2"
        },
        {
          "command": "visual-runner.inputs.renameInput",
          "when": "view == inputs && viewItem == input",
          "group": "modification@1"
        },
        {
          "command": "visual-runner.inputs.deleteItem",
          "when": "view == inputs && (viewItem == file || viewItem == input)",
          "group": "modification@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visual-runner",
          "title": "Visual Runner",
          "icon": "$(play)"
        }
      ],
      "panel": [
        {
          "id": "visual-console",
          "title": "Visual Console",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "visual-runner": [
        {
          "id": "inputs",
          "name": "Inputs",
          "type": "tree",
          "visibility": "collapsed",
          "icon": "$(list-tree)"
        }
      ],
      "visual-console": [
        {
          "id": "visual-console",
          "name": "Visual Console",
          "type": "webview",
          "visibility": "visible",
          "icon": "$(terminal)"
        }
      ]
    },
    "configuration": {
      "title": "Visual Runner",
      "properties": {
        "visual-runner.execution.maxBuffer": {
          "type": "number",
          "default": 1048576,
          "description": "Maximum output buffer size in bytes"
        },
        "visual-runner.execution.shell": {
          "type": "string",
          "description": "Custom shell for execution (leave empty for default)"
        },
        "visual-runner.cache.lifetime": {
          "type": "number",
          "default": 3600000,
          "description": "Cache cleanup interval in milliseconds"
        },
        "visual-runner.storage.location": {
          "type": "string",
          "default": ".vscode/.runner",
          "description": "Input storage location relative to workspace"
        },
        "visual-runner.storage.maxSize": {
          "type": "number",
          "default": 10485760,
          "description": "Maximum storage size in bytes"
        },
        "visual-runner.storage.autoSave": {
          "type": "number",
          "default": 1000,
          "description": "Auto-save frequency in milliseconds"
        },
        "visual-runner.input.defaultMode": {
          "type": "string",
          "enum": [
            "sequential",
            "parallel"
          ],
          "default": "sequential",
          "description": "Default execution mode for multiple inputs"
        },
        "visual-runner.input.autoFocus": {
          "type": "boolean",
          "default": true,
          "description": "Auto-focus input field when waiting for input"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run clean  && npm run build:contribution && npm run compile:webview && npm run compile:extension",
    "clean": "rmdir /s /q dist",
    "build:contribution": "ts-node -r tsconfig-paths/register scripts/build-contribution.ts",
    "compile:webview": "vite build --config vite.config.webview.mjs",
    "compile:extension": "node esbuild.mjs",
    "watch": "concurrently \"npm run watch:webview\" \"npm run watch:extension\"",
    "watch:webview": "vite build --config vite.config.webview.mjs --watch",
    "watch:extension": "tsc -p tsconfig.json -w",
    "package": "npm run compile",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/codicons": "^0.0.39",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.10",
    "eslint": "^9.23.0",
    "svelte": "^5.38.6",
    "svelte-check": "^4.3.1",
    "svelte-preprocess": "^6.0.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2",
    "vite": "^5.4.0-beta.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "license": "MIT"
}

{
  "name": "visual-runner",
  "displayName": "Visual Runner",
  "description": "A clean, interactive console to run and test code with managed inputs - no terminal clutter, just pure interaction",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onWebviewPanel:visualRunner",
    "onCommand:visual-runner.runFile",
    "onCommand:visual-runner.suspendExecution",
    "onCommand:visual-runner.rerunFile",
    "onCommand:visual-runner.stopExecution"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "visual-runner.runFile",
        "title": "Visual Runner: Run File",
        "shortTitle": "Run",
        "icon": "$(play)",
        "category": "Visual Runner"
      },
      {
        "command": "visual-runner.suspendExecution",
        "title": "Visual Runner: Suspend Execution",
        "shortTitle": "Suspend",
        "icon": "$(debug-pause)",
        "category": "Visual Runner"
      },
      {
        "command": "visual-runner.rerunFile",
        "title": "Visual Runner: Rerun File",
        "shortTitle": "Rerun",
        "icon": "$(refresh)",
        "category": "Visual Runner"
      },
      {
        "command": "visual-runner.stopExecution",
        "title": "Visual Runner: Stop Execution",
        "shortTitle": "Stop",
        "icon": "$(debug-stop)",
        "category": "Visual Runner"
      },
      {
        "command": "visual-runner.addInput",
        "title": "Add Input",
        "icon": "$(add)",
        "category": "Visual Runner"
      },
      {
        "command": "visual-runner.clearConsole",
        "title": "Clear Console",
        "icon": "$(clear-all)",
        "category": "Visual Runner"
      }
    ],
    "keybindings": [
      {
        "command": "visual-runner.runFile",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorFocus"
      },
      {
        "command": "visual-runner.suspendExecution",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "visualRunner.isRunning"
      },
      {
        "command": "visual-runner.rerunFile",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r",
        "when": "editorFocus"
      },
      {
        "command": "visual-runner.stopExecution",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x",
        "when": "visualRunner.isRunning"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "visual-runner.runFile",
          "group": "navigation",
          "when": "resourceLangId =~ /^(python|javascript|typescript|java)$/"
        }
      ],
      "editor/title/run": [
        {
          "command": "visual-runner.runFile",
          "when": "resourceLangId =~ /^(python|javascript|typescript|java)$/",
          "group": "navigation@1"
        },
        {
          "command": "visual-runner.rerunFile",
          "when": "resourceLangId =~ /^(python|javascript|typescript|java)$/",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "visual-runner.runFile",
          "when": "resourceLangId =~ /^(python|javascript|typescript|java)$/"
        },
        {
          "command": "visual-runner.suspendExecution",
          "when": "visualRunner.isRunning"
        },
        {
          "command": "visual-runner.rerunFile",
          "when": "resourceLangId =~ /^(python|javascript|typescript|java)$/"
        },
        {
          "command": "visual-runner.stopExecution",
          "when": "visualRunner.isRunning"
        }
      ],
      "view/title": [
        {
          "command": "visual-runner.addInput",
          "when": "view == visual-runner-inputs",
          "group": "navigation"
        },
        {
          "command": "visual-runner.clearConsole",
          "when": "view == visual-runner-console",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "visual-runner.editInput",
          "when": "view == visual-runner-inputs",
          "group": "inline"
        },
        {
          "command": "visual-runner.deleteInput",
          "when": "view == visual-runner-inputs",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visual-runner",
          "title": "Visual Runner",
          "icon": "$(play)"
        }
      ]
    },
    "views": {
      "visual-runner": [
        {
          "id": "visual-runner-inputs",
          "name": "Inputs",
          "type": "tree",
          "visibility": "collapsed"
        },
        {
          "id": "visual-runner-console",
          "name": "Console",
          "type": "tree",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "Visual Runner",
      "properties": {
        "visualRunner.theme.useEditorColors": {
          "type": "boolean",
          "default": true,
          "description": "Use VS Code editor colors for the Visual Runner interface"
        },
        "visualRunner.console.fontFamily": {
          "type": "string",
          "default": "monospace",
          "description": "Font family for the console output"
        },
        "visualRunner.console.fontSize": {
          "type": "number",
          "default": 14,
          "description": "Font size for the console output"
        },
        "visualRunner.input.defaultColor": {
          "type": "string",
          "default": "#007ACC",
          "description": "Default color for new input views"
        },
        "visualRunner.execution.timeout": {
          "type": "number",
          "default": 30000,
          "description": "Process execution timeout in milliseconds"
        },
        "visualRunner.execution.maxBuffer": {
          "type": "number",
          "default": 1048576,
          "description": "Maximum output buffer size in bytes"
        },
        "visualRunner.execution.shell": {
          "type": "string",
          "description": "Custom shell for execution (leave empty for default)"
        },
        "visualRunner.cache.lifetime": {
          "type": "number",
          "default": 3600000,
          "description": "Cache cleanup interval in milliseconds"
        },
        "visualRunner.storage.location": {
          "type": "string",
          "default": ".vscode/.runner",
          "description": "Input storage location relative to workspace"
        },
        "visualRunner.storage.maxSize": {
          "type": "number",
          "default": 10485760,
          "description": "Maximum storage size in bytes"
        },
        "visualRunner.storage.autoSave": {
          "type": "number",
          "default": 1000,
          "description": "Auto-save frequency in milliseconds"
        },
        "visualRunner.input.maxViews": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of input views"
        },
        "visualRunner.input.defaultMode": {
          "type": "string",
          "enum": [
            "sequential",
            "parallel"
          ],
          "default": "sequential",
          "description": "Default execution mode for multiple inputs"
        },
        "visualRunner.input.autoFocus": {
          "type": "boolean",
          "default": true,
          "description": "Auto-focus input field when waiting for input"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.23.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@preact/signals": "^2.0.4",
    "@vscode/codicons": "^0.0.36",
    "preact": "^10.26.5"
  }
}
